rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn()
        && currentUser().data.role == role;
    }

    function isAdmin() {
      return signedIn() && currentUser().data.isAdmin == true;
    }

    function isBookingParticipant(data) {
      return signedIn()
        && request.auth.uid in [data.clientId, data.providerId];
    }

    function bookingCoreUnchanged() {
      return request.resource.data.clientId == resource.data.clientId
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.providerName == resource.data.providerName
        && request.resource.data.serviceName == resource.data.serviceName
        && request.resource.data.priceCents == resource.data.priceCents
        && request.resource.data.address == resource.data.address
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validCancellationUpdate() {
      return resource.data.status in ['requested', 'accepted', 'onTheWay']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancellationReason is string
        && request.resource.data.cancellationReason.size() > 0
        && request.resource.data.cancellationReason.size() <= 120
        && request.resource.data.simulatedFeeCents == 0
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'cancellationReason',
            'cancelledBy',
            'simulatedFeeCents',
            'updatedAt'
          ]);
    }

    function validClientBookingUpdate() {
      return request.auth.uid == resource.data.clientId
        && (
          validCancellationUpdate()
          || resource.data.status == 'completed'
            && request.resource.data.status == 'reviewed'
            && resource.data.clientRating == 0
            && request.resource.data.clientRating is int
            && request.resource.data.clientRating >= 1
            && request.resource.data.clientRating <= 5
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'clientRating', 'updatedAt'])
        );
    }

    function validProviderBookingUpdate() {
      return request.auth.uid == resource.data.providerId
        && (
          validCancellationUpdate()
          ||
          resource.data.status == 'requested'
            && request.resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          || resource.data.status == 'accepted'
            && request.resource.data.status == 'onTheWay'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          || resource.data.status == 'onTheWay'
            && request.resource.data.status == 'inProgress'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          || resource.data.status == 'inProgress'
            && request.resource.data.status == 'completed'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          || resource.data.status in ['completed', 'reviewed']
            && request.resource.data.status == resource.data.status
            && resource.data.providerRating == 0
            && request.resource.data.providerRating is int
            && request.resource.data.providerRating >= 1
            && request.resource.data.providerRating <= 5
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['providerRating', 'updatedAt'])
        );
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'phone',
          'role',
          'identityStatus',
          'points',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role in ['client', 'provider']
        && request.resource.data.identityStatus == 'pending'
        && (
          request.resource.data.role == 'client'
            && request.resource.data.points == 0
          || request.resource.data.role == 'provider'
            && request.resource.data.points == null
        );
      allow read: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'photoUrl', 'updatedAt']);
      allow delete: if false;
    }

    match /professionals/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && hasRole('provider')
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'specialty',
          'priceCents',
          'rating',
          'services',
          'isOnline',
          'photoUrl',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.isOnline is bool;
      allow update: if isSelf(uid)
        && hasRole('provider')
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'specialty', 'priceCents', 'photoUrl', 'isOnline', 'updatedAt']);
      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow create: if hasRole('client')
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.providerId is string
        && exists(/databases/$(database)/documents/professionals/$(request.resource.data.providerId))
        && get(/databases/$(database)/documents/professionals/$(request.resource.data.providerId)).data.isOnline == true
        && request.resource.data.keys().hasOnly([
          'clientId',
          'providerId',
          'clientName',
          'providerName',
          'serviceName',
          'priceCents',
          'address',
          'paymentMethod',
          'status',
          'clientRating',
          'providerRating',
          'cancellationReason',
          'cancelledBy',
          'simulatedFeeCents',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.status == 'requested'
        && request.resource.data.serviceName == 'Manicure e Pedicure'
        && request.resource.data.priceCents == 6000
        && request.resource.data.paymentMethod in ['Pix', 'Cartão', 'Dinheiro']
        && request.resource.data.clientRating == 0
        && request.resource.data.providerRating == 0
        && request.resource.data.cancellationReason == ''
        && request.resource.data.cancelledBy == ''
        && request.resource.data.simulatedFeeCents == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read: if isBookingParticipant(resource.data) || isAdmin();
      allow update: if isBookingParticipant(resource.data)
        && bookingCoreUnchanged()
        && request.resource.data.updatedAt == request.time
        && (validClientBookingUpdate() || validProviderBookingUpdate());
      allow delete: if false;

      match /quickMessages/{messageId} {
        function booking() {
          return get(/databases/$(database)/documents/bookings/$(bookingId));
        }

        allow read: if isBookingParticipant(booking().data);
        allow create: if isBookingParticipant(booking().data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId', 'body', 'createdAt'])
          && request.resource.data.body in [
            'Pode subir/entrar',
            'Estou descendo',
            'Campainha quebrada'
          ]
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /ratings/{ratingId} {
      function relatedBooking() {
        return get(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        );
      }

      allow create: if signedIn()
        && ratingId == request.resource.data.bookingId + '_' + request.auth.uid
        && request.resource.data.fromUid == request.auth.uid
        && isBookingParticipant(relatedBooking().data)
        && relatedBooking().data.status in ['completed', 'reviewed']
        && request.resource.data.toUid
          in [relatedBooking().data.clientId, relatedBooking().data.providerId]
        && request.resource.data.toUid != request.resource.data.fromUid
        && request.resource.data.keys().hasOnly([
          'bookingId',
          'fromUid',
          'toUid',
          'score',
          'tags',
          'comment',
          'createdAt'
        ])
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 6
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn()
        && (
          request.auth.uid in [resource.data.fromUid, resource.data.toUid]
          || isAdmin()
        );
      allow update, delete: if false;
    }

    match /subscriptions/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /accountDeletionRequests/{uid} {
      function validDeletionRequest() {
        return isSelf(uid)
          && request.resource.data.keys().hasOnly([
            'uid',
            'status',
            'requestedAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.status == 'requested'
          && request.resource.data.requestedAt == request.time;
      }

      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if validDeletionRequest();
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'reporterId',
          'bookingId',
          'category',
          'description',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.category in [
          'Segurança',
          'Conduta',
          'Pagamento',
          'Problema técnico',
          'Outro'
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read: if isAdmin()
        || signedIn() && resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['open', 'reviewing', 'resolved']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
